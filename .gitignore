# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the Package Manager
# (.jl and .pkg directories are exclusive to Julia <= 0.6)
.jl
.pkg
Manifest.toml

# Build artifacts
deps/build.log
deps/deps.jl
deps/usr/
docs/build/
docs/site/

# Environment files
.env
.DS_Store

# Temporary files
*.swp
*~

# Downloaded julia binaries and directories
julia-*/
julia-*.tar.gz
